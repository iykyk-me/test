<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f8f7f2">
  <link rel="icon" href="data:,">
  <title>말해요 - 마음을 전해요</title>
  <style>
    :root {
      color-scheme: light;
      --ink: #24324a;
      --muted: #68758a;
      --paper: #f8f7f2;
      --white: #fff;
      --line: #e7e7e0;
      --blue: #4569df;
      --green: #268264;
      --shadow: 0 12px 30px rgba(45, 57, 77, .08);
      font-family: "Apple SD Gothic Neo", "Malgun Gothic", system-ui, sans-serif;
    }
    * { box-sizing: border-box; }
    body { margin: 0; min-width: 320px; min-height: 100vh; background: var(--paper); color: var(--ink); }
    button { font: inherit; color: inherit; }
    .app { width: min(100%, 1120px); margin: 0 auto; padding: 22px 28px 42px; }
    .topbar { height: 58px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .brand { display: flex; align-items: center; gap: 10px; font-size: 20px; font-weight: 850; letter-spacing: -.7px; }
    .brand-mark { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 14px; background: #e7edff; color: var(--blue); }
    .brand-mark svg { width: 24px; height: 24px; }
    .mode-switch { display: flex; gap: 4px; padding: 4px; border: 1px solid var(--line); border-radius: 15px; background: #efeee8; }
    .mode-button { min-height: 42px; padding: 0 16px; border: 0; border-radius: 11px; background: transparent; color: #647087; font-weight: 750; cursor: pointer; transition: background .18s, color .18s, box-shadow .18s; }
    .mode-button[aria-pressed="true"] { background: white; color: var(--ink); box-shadow: 0 2px 7px #26355016; }
    .mode-button:focus-visible, .request-card:focus-visible, .action-button:focus-visible, .icon-button:focus-visible { outline: 3px solid #f0a93e; outline-offset: 3px; }
    .main { margin-top: 24px; }
    .child-layout { display: grid; grid-template-columns: minmax(0, 1fr) 250px; gap: 22px; align-items: start; }
    .welcome { position: relative; overflow: hidden; display: flex; align-items: center; justify-content: space-between; min-height: 192px; padding: 28px 34px; border-radius: 26px; background: #e9efff; }
    .welcome-copy { position: relative; z-index: 1; }
    .eyebrow { display: flex; align-items: center; gap: 7px; margin: 0 0 10px; color: #4c65b4; font-size: 14px; font-weight: 800; }
    .eyebrow svg { width: 17px; height: 17px; }
    h1 { margin: 0; font-size: clamp(28px, 4vw, 40px); line-height: 1.18; letter-spacing: -1.8px; }
    .welcome-copy > p:last-child { margin: 10px 0 0; color: #52617d; font-size: 16px; line-height: 1.55; }
    .welcome-art { flex: 0 0 auto; width: 158px; height: 144px; margin: -7px 8px -9px 8px; }
    .cards-heading { display: flex; justify-content: space-between; align-items: end; margin: 27px 2px 13px; }
    .cards-heading h2 { margin: 0; font-size: 19px; letter-spacing: -.5px; }
    .cards-heading span { color: var(--muted); font-size: 13px; }
    .request-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .request-card { position: relative; display: flex; min-height: 156px; flex-direction: column; align-items: flex-start; justify-content: space-between; padding: 16px 17px; overflow: hidden; border: 1px solid #e9e8e1; border-radius: 20px; background: var(--white); box-shadow: 0 3px 9px #35445b08; text-align: left; cursor: pointer; transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease; }
    .request-card:hover { transform: translateY(-3px); border-color: #d2d9ec; box-shadow: var(--shadow); }
    .request-card:active { transform: scale(.98); }
    .request-card .pictogram { display: grid; place-items: center; width: 68px; height: 68px; border-radius: 21px; }
    .pictogram svg { width: 47px; height: 47px; }
    .request-card strong { font-size: 19px; letter-spacing: -.5px; }
    .request-card small { margin-top: 3px; color: #758096; font-size: 12px; }
    .card-label { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 5px; }
    .card-label svg { width: 17px; height: 17px; color: #9aa3b1; }
    .water .pictogram { background: #e0f2ff; color: #3885ce; }
    .toilet .pictogram { background: #efe8ff; color: #8463d5; }
    .help .pictogram { background: #fff0d9; color: #d68a22; }
    .hurt .pictogram { background: #ffe6e2; color: #dd715e; }
    .rest .pictogram { background: #e4f4e8; color: #47956a; }
    .food .pictogram { background: #fff0d5; color: #cb8840; }
    .side-column { display: grid; gap: 14px; }
    .side-card { padding: 21px; border: 1px solid var(--line); border-radius: 22px; background: #fff; }
    .side-title { display: flex; align-items: center; gap: 9px; margin: 0 0 15px; font-size: 16px; font-weight: 800; }
    .side-title svg { width: 20px; height: 20px; color: var(--blue); }
    .pending-count { display: grid; place-items: center; width: 23px; height: 23px; margin-left: auto; border-radius: 50%; background: #edf1ff; color: #4d68c8; font-size: 12px; }
    .empty-state { display: grid; justify-items: center; padding: 15px 0 5px; text-align: center; }
    .empty-state svg { width: 55px; height: 55px; margin-bottom: 9px; color: #8a9be0; }
    .empty-state p { margin: 0; color: #748096; font-size: 13px; line-height: 1.6; }
    .pending-list { display: grid; gap: 9px; }
    .pending-item { display: flex; align-items: center; gap: 10px; padding: 10px 11px; border-radius: 14px; background: #f6f7fb; }
    .pending-item svg { width: 29px; height: 29px; color: var(--blue); flex: none; }
    .pending-item strong { display: block; font-size: 14px; }
    .pending-item small { color: #7a8496; font-size: 11px; }
    .pending-mark { margin-left: auto; color: #d58a25; font-size: 11px; font-weight: 800; }
    .voice-control { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 18px; border-radius: 18px; background: #eef5ed; }
    .voice-copy strong { display: block; font-size: 14px; }
    .voice-copy small { display: block; margin-top: 4px; color: #718171; font-size: 11px; }
    .toggle { position: relative; width: 50px; height: 30px; padding: 0; flex: none; border: 0; border-radius: 20px; background: #b9c2b7; cursor: pointer; transition: background .2s; }
    .toggle::after { position: absolute; top: 4px; left: 4px; width: 22px; height: 22px; border-radius: 50%; background: white; content: ""; box-shadow: 0 1px 4px #0002; transition: transform .2s; }
    .toggle[aria-checked="true"] { background: #3d9a69; }
    .toggle[aria-checked="true"]::after { transform: translateX(20px); }
    .privacy-note { display: flex; gap: 9px; align-items: flex-start; padding: 2px 5px; color: #778194; font-size: 12px; line-height: 1.55; }
    .privacy-note svg { width: 18px; height: 18px; flex: none; color: #7b8bb5; }
    .teacher-view { max-width: 820px; margin: 0 auto; }
    .teacher-head { display: flex; align-items: end; justify-content: space-between; gap: 15px; margin-bottom: 20px; }
    .teacher-head h1 { font-size: 34px; }
    .teacher-head p { margin: 8px 0 0; color: var(--muted); }
    .teacher-summary { display: flex; align-items: center; gap: 9px; padding: 11px 15px; border: 1px solid #e8e8e1; border-radius: 14px; background: white; color: #52617a; font-weight: 700; }
    .teacher-summary svg { width: 19px; height: 19px; color: var(--blue); }
    .teacher-inbox { padding: 24px; border: 1px solid var(--line); border-radius: 24px; background: white; box-shadow: var(--shadow); }
    .inbox-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px; }
    .inbox-heading h2 { margin: 0; font-size: 19px; }
    .live-label { display: flex; align-items: center; gap: 7px; color: #778294; font-size: 12px; }
    .live-dot { width: 8px; height: 8px; border-radius: 50%; background: #42a679; box-shadow: 0 0 0 4px #42a67920; }
    .teacher-list { display: grid; gap: 10px; }
    .teacher-request { display: grid; grid-template-columns: 58px 1fr auto; align-items: center; gap: 15px; padding: 15px; border: 1px solid #ecece7; border-radius: 17px; background: #fff; }
    .teacher-request .pictogram { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 17px; background: #edf1ff; color: var(--blue); }
    .teacher-request .pictogram svg { width: 36px; height: 36px; }
    .request-content strong { display: block; font-size: 18px; }
    .request-content p { margin: 4px 0 0; color: #7b8596; font-size: 13px; }
    .request-state { display: inline-flex; align-items: center; gap: 6px; margin-top: 9px; color: #c08025; font-size: 12px; font-weight: 750; }
    .request-state.done { color: #27815b; }
    .request-state svg { width: 15px; height: 15px; }
    .action-button { min-height: 44px; padding: 0 15px; border: 0; border-radius: 12px; background: #e8f5ed; color: #28794f; font-weight: 800; cursor: pointer; transition: background .15s, transform .15s; }
    .action-button:hover { background: #d9efdf; }
    .action-button:active { transform: scale(.97); }
    .action-button:disabled { background: #f2f3f2; color: #818a87; cursor: default; }
    .teacher-empty { padding: 47px 20px; text-align: center; color: #778294; }
    .teacher-empty svg { width: 60px; height: 60px; color: #8a9be0; }
    .teacher-empty strong { display: block; margin-top: 8px; color: #354158; font-size: 17px; }
    .teacher-empty p { margin: 7px 0 0; font-size: 14px; }
    .teacher-footnote { display: flex; gap: 9px; align-items: center; margin-top: 15px; padding: 14px 17px; border-radius: 15px; background: #f0efe8; color: #717a88; font-size: 13px; line-height: 1.5; }
    .teacher-footnote svg { width: 19px; height: 19px; flex: none; color: #7988b3; }
    .notice { position: fixed; z-index: 5; right: 24px; bottom: 24px; display: flex; align-items: center; gap: 11px; max-width: min(410px, calc(100vw - 32px)); padding: 15px 19px; border-radius: 17px; background: #283652; color: white; box-shadow: 0 12px 35px #14213d33; opacity: 0; transform: translateY(12px); pointer-events: none; transition: opacity .2s, transform .2s; }
    .notice.show { opacity: 1; transform: translateY(0); }
    .notice svg { width: 22px; height: 22px; flex: none; color: #9fe0b1; }
    .notice strong { display: block; font-size: 14px; }
    .notice span { display: block; margin-top: 2px; color: #d7deec; font-size: 12px; }
    [hidden] { display: none !important; }
    @media (max-width: 760px) {
      .app { padding: 13px 15px 28px; }
      .topbar { height: auto; min-height: 55px; }
      .brand { font-size: 18px; }
      .brand-mark { width: 36px; height: 36px; }
      .mode-button { min-height: 40px; padding: 0 12px; font-size: 13px; }
      .main { margin-top: 18px; }
      .child-layout { grid-template-columns: 1fr; gap: 15px; }
      .welcome { min-height: 170px; padding: 23px; border-radius: 22px; }
      .welcome-art { width: 110px; height: 110px; margin: 0 -8px 0 3px; }
      .welcome-copy > p:last-child { max-width: 240px; font-size: 14px; }
      .cards-heading { margin-top: 23px; }
      .request-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
      .request-card { min-height: 143px; padding: 13px; border-radius: 18px; }
      .request-card .pictogram { width: 60px; height: 60px; border-radius: 18px; }
      .pictogram svg { width: 42px; height: 42px; }
      .request-card strong { font-size: 17px; }
      .side-column { grid-template-columns: 1fr 1fr; gap: 10px; }
      .side-card { padding: 16px; border-radius: 18px; }
      .side-card:first-child { grid-column: 1 / -1; }
      .side-title { margin-bottom: 8px; }
      .empty-state { padding: 6px 0 1px; }
      .empty-state svg { width: 39px; height: 39px; }
      .empty-state p { font-size: 12px; }
      .voice-control { padding: 12px; }
      .privacy-note { align-items: center; padding: 0; font-size: 11px; }
      .teacher-head { align-items: flex-start; flex-direction: column; }
      .teacher-head h1 { font-size: 29px; }
      .teacher-inbox { padding: 17px; border-radius: 20px; }
      .teacher-request { grid-template-columns: 48px 1fr; gap: 12px; padding: 12px; }
      .teacher-request .pictogram { width: 48px; height: 48px; }
      .teacher-request .pictogram svg { width: 31px; height: 31px; }
      .teacher-request .action-button { grid-column: 2; justify-self: start; }
      .notice { right: 16px; bottom: 16px; }
    }
    @media (max-width: 390px) {
      .brand { gap: 7px; font-size: 16px; }
      .mode-switch { gap: 2px; }
      .mode-button { padding: 0 9px; font-size: 12px; }
      .welcome { padding: 19px; }
      h1 { font-size: 28px; }
      .welcome-art { width: 88px; height: 94px; }
      .request-card { min-height: 135px; }
      .side-column { grid-template-columns: 1fr; }
      .side-card:first-child { grid-column: auto; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; }
    }
  </style>
</head>
