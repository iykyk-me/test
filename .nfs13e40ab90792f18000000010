  <div class="app">
    <header class="topbar">
      <div class="brand"><span class="brand-mark"><svg aria-hidden="true"><use href="#i-speech"/></svg></span><span>말해요</span></div>
      <nav class="mode-switch" aria-label="화면 선택">
