              <span class="pictogram"><svg aria-hidden="true"><use href="#i-toilet"/></svg></span><span class="card-label"><span><strong>화장실 갈래요</strong><small>화장실에 가고 싶어요</small></span><svg aria-hidden="true"><use href="#i-arrow"/></svg></span>
            </button>
            <button class="request-card help" type="button" data-id="help" data-sentence="도와주세요" aria-label="도와주세요">
              <span class="pictogram"><svg aria-hidden="true"><use href="#i-help"/></svg></span><span class="card-label"><span><strong>도와주세요</strong><small>선생님이 필요해요</small></span><svg aria-hidden="true"><use href="#i-arrow"/></svg></span>
            </button>
            <button class="request-card hurt" type="button" data-id="hurt" data-sentence="아파요" aria-label="아파요">
              <span class="pictogram"><svg aria-hidden="true"><use href="#i-hurt"/></svg></span><span class="card-label"><span><strong>아파요</strong><small>몸이 불편해요</small></span><svg aria-hidden="true"><use href="#i-arrow"/></svg></span>
            </button>
            <button class="request-card rest" type="button" data-id="rest" data-sentence="쉬고 싶어요" aria-label="쉬고 싶어요">
              <span class="pictogram"><svg aria-hidden="true"><use href="#i-rest"/></svg></span><span class="card-label"><span><strong>쉬고 싶어요</strong><small>조금 쉬고 싶어요</small></span><svg aria-hidden="true"><use href="#i-arrow"/></svg></span>
            </button>
            <button class="request-card food" type="button" data-id="food" data-sentence="배고파요" aria-label="배고파요">
              <span class="pictogram"><svg aria-hidden="true"><use href="#i-food"/></svg></span><span class="card-label"><span><strong>배고파요</strong><small>간식 먹고 싶어요</small></span><svg aria-hidden="true"><use href="#i-arrow"/></svg></span>
            </button>
          </div>
        </div>
        <aside class="side-column" aria-label="요청과 설정">
          <section class="side-card">
            <h2 class="side-title"><svg aria-hidden="true"><use href="#i-bell"/></svg>내가 보낸 말 <span class="pending-count" id="pendingCount">0</span></h2>
            <div class="empty-state" id="childEmpty"><svg aria-hidden="true"><use href="#i-empty"/></svg><p>아직 보낸 말이 없어요.<br>필요한 그림을 눌러보세요!</p></div>
            <div class="pending-list" id="childPendingList" hidden></div>
          </section>
          <section class="voice-control">
            <div class="voice-copy"><strong>소리로 읽어주기</strong><small>버튼을 누르면 말해요</small></div>
            <button class="toggle" id="voiceToggle" type="button" role="switch" aria-checked="true" aria-label="소리로 읽어주기 켜기"></button>
          </section>
          <div class="privacy-note"><svg aria-hidden="true"><use href="#i-lock"/></svg><span>요청 내용은 이 화면 안에서만 보여요. 선생님과 함께 사용해 주세요.</span></div>
        </aside>
      </section>

      <section class="teacher-view" id="teacherView" aria-label="선생님 요청 확인 화면" hidden>
        <div class="teacher-head">
          <div><p class="eyebrow"><svg aria-hidden="true"><use href="#i-bell"/></svg>요청 확인</p><h1>아이의 마음이 도착했어요</h1><p>아이 화면에서 선택한 요청을 확인해 주세요.</p></div>
          <div class="teacher-summary"><svg aria-hidden="true"><use href="#i-bell"/></svg><span id="teacherCount">새 요청 0개</span></div>
        </div>
        <div class="teacher-inbox">
          <div class="inbox-heading"><h2>오늘의 요청</h2><span class="live-label"><span class="live-dot"></span>이 기기에서 함께 사용 중</span></div>
          <div class="teacher-list" id="teacherList"></div>
          <div class="teacher-empty" id="teacherEmpty"><svg aria-hidden="true"><use href="#i-empty"/></svg><strong>아직 도착한 요청이 없어요</strong><p>아이 화면에서 그림 버튼을 누르면 여기에 보여요.</p></div>
        </div>
        <div class="teacher-footnote"><svg aria-hidden="true"><use href="#i-lock"/></svg><span>요청은 현재 기기 안에서만 임시로 관리돼요. 화면을 닫으면 내용이 사라집니다.</span></div>
      </section>
    </main>
  </div>
  <div class="notice" id="notice" role="status" aria-live="polite"><svg aria-hidden="true"><use href="#i-check"/></svg><div><strong id="noticeTitle">선생님께 알려드렸어요</strong><span id="noticeMessage">요청을 화면에 표시했어요.</span></div></div>
  <script>
    const labels = {
      water: { title: "물 마시고 싶어요", icon: "water" },
      toilet: { title: "화장실 가고 싶어요", icon: "toilet" },
      help: { title: "도와주세요", icon: "help" },
      hurt: { title: "아파요", icon: "hurt" },
      rest: { title: "쉬고 싶어요", icon: "rest" },
      food: { title: "배고파요", icon: "food" }
    };
    const requests = [];
    const childView = document.querySelector("#childView");
    const teacherView = document.querySelector("#teacherView");
    const childMode = document.querySelector("#childMode");
    const teacherMode = document.querySelector("#teacherMode");
    const notice = document.querySelector("#notice");
    let voiceEnabled = true;
    let noticeTimer;

    function showNotice(title, message) {
      document.querySelector("#noticeTitle").textContent = title;
      document.querySelector("#noticeMessage").textContent = message;
      notice.classList.add("show");
      clearTimeout(noticeTimer);
      noticeTimer = setTimeout(() => notice.classList.remove("show"), 3000);
    }

    function speak(text) {
      if (!voiceEnabled || !("speechSynthesis" in window)) return;
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = "ko-KR";
      utterance.rate = 0.88;
      window.speechSynthesis.speak(utterance);
    }

    function renderRequests() {
      const pending = requests.filter(request => !request.done);
      document.querySelector("#pendingCount").textContent = pending.length;
      document.querySelector("#childEmpty").hidden = requests.length > 0;
      const childList = document.querySelector("#childPendingList");
      childList.hidden = requests.length === 0;
      childList.innerHTML = requests.slice(-3).reverse().map(request => `
        <div class="pending-item">
          <svg aria-hidden="true"><use href="#i-${labels[request.id].icon}"/></svg>
          <span><strong>${labels[request.id].title}</strong><small>${request.done ? "선생님이 확인했어요" : "선생님께 전달했어요"}</small></span>
          <span class="pending-mark">${request.done ? "완료" : "확인 중"}</span>
        </div>`).join("");

      const openCount = pending.length;
      document.querySelector("#teacherCount").textContent = `새 요청 ${openCount}개`;
      document.querySelector("#teacherEmpty").hidden = requests.length > 0;
      document.querySelector("#teacherList").innerHTML = requests.slice().reverse().map(request => `
        <article class="teacher-request">
          <span class="pictogram"><svg aria-hidden="true"><use href="#i-${labels[request.id].icon}"/></svg></span>
          <div class="request-content"><strong>${labels[request.id].title}</strong><p>${request.time} · 아이 화면에서 보냄</p>
            <span class="request-state ${request.done ? "done" : ""}"><svg aria-hidden="true"><use href="#i-${request.done ? "check" : "bell"}"/></svg>${request.done ? "확인 완료" : "확인이 필요해요"}</span>
          </div>
          <button class="action-button" type="button" data-complete="${request.key}" ${request.done ? "disabled" : ""}>${request.done ? "확인했어요" : "확인 완료"}</button>
        </article>`).join("");
    }

    function setMode(mode) {
      const isChild = mode === "child";
      childView.hidden = !isChild;
      teacherView.hidden = isChild;
      childMode.setAttribute("aria-pressed", String(isChild));
      teacherMode.setAttribute("aria-pressed", String(!isChild));
    }

    document.querySelectorAll(".request-card").forEach(button => {
      button.addEventListener("click", () => {
        const id = button.dataset.id;
        const now = new Date();
        const time = new Intl.DateTimeFormat("ko-KR", { hour: "numeric", minute: "2-digit" }).format(now);
        requests.push({ id, time, done: false, key: `${Date.now()}-${Math.random()}` });
        renderRequests();
        speak(button.dataset.sentence);
        showNotice("선생님께 알려드렸어요", `${labels[id].title} · 선생님 화면에도 보여요`);
      });
    });

    document.querySelector("#teacherList").addEventListener("click", event => {
      const button = event.target.closest("[data-complete]");
      if (!button) return;
      const request = requests.find(item => item.key === button.dataset.complete);
      if (request) {
        request.done = true;
        renderRequests();
        showNotice("확인했어요", "아이 화면에도 확인 완료로 표시돼요.");
      }
    });

    childMode.addEventListener("click", () => setMode("child"));
    teacherMode.addEventListener("click", () => setMode("teacher"));
    document.querySelector("#voiceToggle").addEventListener("click", event => {
      voiceEnabled = !voiceEnabled;
      event.currentTarget.setAttribute("aria-checked", String(voiceEnabled));
      event.currentTarget.setAttribute("aria-label", `소리로 읽어주기 ${voiceEnabled ? "켜기" : "끄기"}`);
      if (!voiceEnabled && "speechSynthesis" in window) window.speechSynthesis.cancel();
    });

    renderRequests();
  </script>
  <script src="/__preview-bridge.js" data-preview-bridge></script>
</body>
</html>
